# Connessione
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=21
IBKR_HISTORICAL_DATA_TIMEOUT=30s
IBKR_PAPER_ACCOUNT_ID=DUR883004

# Protezioni ordini: lascia false finché non hai verificato market data e segnali.
IBKR_PAPER_ORDERS_ENABLED=false
PAPER_ACCOUNT_CONFIRMATION=I_CONFIRM_THIS_IS_A_PAPER_ACCOUNT

# Strategia automatica: genera segnali per default ma non li esegue.
AUTO_EXECUTE_SIGNALS=false
STRATEGY_ENABLED=true

# Dati
IBKR_MARKET_DATA_MODE=DELAYED

# Database H2 locale. AUTO_SERVER consente a piu' processi locali di usare
# lo stesso file quando vengono avviati con questa stessa URL.
DB_URL=jdbc:h2:file:./data/ibkr-paper-trading;AUTO_SERVER=TRUE

# Risk manager LONG/SHORT
RISK_TRADING_CAPITAL=10000
RISK_PER_TRADE_PERCENT=2.0
RISK_ALLOW_LONG=true
RISK_ALLOW_SHORT=true
RISK_USE_LEVERAGE=false
RISK_MAX_LONG_NOTIONAL=10000
RISK_MAX_SHORT_NOTIONAL=10000
RISK_MAX_ORDER_VALUE=5000
RISK_MAX_POSITION_VALUE=10000
RISK_MAX_QUANTITY=1000
RISK_ENTRY_TICKET=0.01
RISK_COMMISSION_PER_ORDER=0
RISK_SLIPPAGE_PERCENT=0
RISK_TRANSACTION_COSTS_PER_SHARE=0

# Take profit condivisi per LONG e SHORT
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_1_PROFIT_PERCENT=2.0
TAKE_PROFIT_1_POSITION_PERCENT=50.0
TAKE_PROFIT_2_PROFIT_PERCENT=4.0
TAKE_PROFIT_2_POSITION_PERCENT=30.0
TAKE_PROFIT_3_PROFIT_PERCENT=8.0
TAKE_PROFIT_3_POSITION_PERCENT=20.0
