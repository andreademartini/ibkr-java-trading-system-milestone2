# Connessione
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=21
IBKR_PAPER_ACCOUNT_ID=INSERISCI_ACCOUNT_PAPER

# Protezioni ordini: lascia false finché non hai verificato market data e segnali.
IBKR_PAPER_ORDERS_ENABLED=false
PAPER_ACCOUNT_CONFIRMATION=I_CONFIRM_THIS_IS_A_PAPER_ACCOUNT

# Strategia automatica: genera segnali per default ma non li esegue.
AUTO_EXECUTE_SIGNALS=false
STRATEGY_ENABLED=true

# Dati
MARKET_DATA_PROVIDER=MANUAL
IBKR_MARKET_DATA_MODE=DELAYED
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_POLLING_INTERVAL=1m
TRADING_SYMBOL_1=SPY
